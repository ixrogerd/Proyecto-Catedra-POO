<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<connectionStrings>
		<add name="CitasMedicasConnection"
             connectionString="Server=localhost;Database=CitasMedicasDB;Integrated Security=true;Encrypt=False;TrustServerCertificate=True;"
             providerName="System.Data.SqlClient" />
		<!-- Alternativa con usuario de SQL Server (cambia TU_CLAVE y deja solo UNA cadena activa):
        <add name="CitasMedicasConnection"
             connectionString="Server=localhost;Database=CitasMedicasDB;User ID=sa;Password=TU_CLAVE;Encrypt=False;TrustServerCertificate=True;"
             providerName="System.Data.SqlClient" />
        -->
	</connectionStrings>
</configuration>